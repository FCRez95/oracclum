{
  "name": "orac-back",
  "version": "1.2.0",
  "description": "Node.js backend API for Oracclum campaign attribution and optimization workflows.",
  "main": "dist/main/server-prod.js",
  "scripts": {
    "start": "node dist/main/server-prod.js",
    "build": "rimraf dist && tsc",
    "dev": "sucrase-node src/main/server.ts",
    "test": "jest --passWithNoTests --silent --noStackTrace --runInBand -c jest-unit-config.js",
    "test:verbose": "jest --passWithNoTests --runInBand -c jest-unit-config.js",
    "test:unit": "jest --passWithNoTests --runInBand -c jest-unit-config.js",
    "test:db": "jest --passWithNoTests --runInBand -c jest-db-config.js",
    "test:db:watch": "npm run test:db -- --watch",
    "test:staged": "npm test -- --findRelatedTests",
    "test:ci": "jest --passWithNoTests --silent --noStackTrace --runInBand -c jest-unit-config.js --coverage",
    "clear_jest": "jest --clearCache"
  },
  "keywords": [
    "nodejs",
    "express",
    "typescript",
    "clean-architecture",
    "mysql",
    "campaign-attribution",
    "portfolio"
  ],
  "author": "Fabio Rezende",
  "license": "ISC",
  "devDependencies": {
    "@swc/core": "^1.15.41",
    "@swc/jest": "^0.2.39",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.9.3",
    "@types/supertest": "^7.2.0",
    "@types/validator": "^13.15.10",
    "jest": "^30.4.2",
    "rimraf": "^6.1.3",
    "sucrase": "^3.35.1",
    "supertest": "^7.2.2",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.22.5",
    "validator": "^13.15.35"
  },
  "engines": {
    "node": ">=24.16.0"
  },
  "overrides": {
    "js-yaml": "^4.2.0"
  }
}
