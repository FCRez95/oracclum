# Local app/session configuration
# Generate a long random value for local development.
SESSION_SECRET="replace-with-a-long-random-local-secret"

# Meta OAuth integration
# Required only when testing the real Meta OAuth flow.
FB_APP_ID="your-meta-app-id"
FB_APP_SECRET="your-meta-app-secret"
FB_REDIRECT_URI="http://localhost:3000/api/meta/oauth/callback"
META_OAUTH_REDIRECT_URI="http://localhost:3000/api/meta/oauth/callback"
META_API_VERSION="v24.0"

# App and service URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_URL="http://localhost:3000"
NEXT_PUBLIC_LANDING_URL="http://localhost:3000"
BACKEND_API_URL="http://localhost:5050/api"
NEXT_PUBLIC_BACKEND_API_URL="http://localhost:5050/api"
POSTBACK_BASE_URL="http://localhost:5050/api"
NEXT_PUBLIC_POSTBACK_BASE_URL="http://localhost:5050/api"
ALLOWED_ORIGINS="http://localhost:3000,https://localhost:3000"
TABOOLA_API_BASE_URL="https://backstage.taboola.com/backstage/api/1.0/"

# Optional app URL overrides
# NEXT_PUBLIC_APP_URL="http://localhost:3000"
# APP_URL="http://localhost:3000"
